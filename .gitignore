* {
  box-sizing: border-box;
}

:root {
  --bg: #f5f3f6;
  --panel: rgba(255, 255, 255, 0.88);
  --panel-solid: #ffffff;
  --soft-gray: #f0f1f5;
  --gray: #787c89;
  --dark: #1d1f2a;
  --pink: #ff4d8d;
  --purple: #8b5cf6;
  --shadow: 0 18px 45px rgba(30, 21, 58, 0.08);
}

body {
  margin: 0;
  min-height: 100vh;
  font-family: Inter, 'Segoe UI', sans-serif;
  background:
    radial-gradient(circle at top left, rgba(255, 77, 141, 0.18), transparent 25%),
    radial-gradient(circle at bottom right, rgba(139, 92, 246, 0.16), transparent 20%),
    var(--bg);
  color: var(--dark);
}

button,
input {
  font: inherit;
}

button {
  cursor: pointer;
}

#root {
  min-height: 100vh;
}

.app-shell {
  max-width: 1500px;
  margin: 32px auto;
  padding: 18px;
  display: flex;
  gap: 24px;
  border-radius: 32px;
  background: rgba(255, 255, 255, 0.55);
  backdrop-filter: blur(10px);
  box-shadow: var(--shadow);
}

.sidebar {
  width: 250px;
  background: rgba(255, 255, 255, 0.74);
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 28px;
  padding: 22px 18px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 6px 8px 18px;
}

.brand-mark {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, #ff8dbc, #8b5cf6);
  color: white;
  font-weight: 700;
}

.brand-name {
  font-weight: 800;
  font-size: 1.05rem;
}

.brand-tag {
  color: var(--gray);
  font-size: 0.75rem;
}

.nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 16px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  border: none;
  border-radius: 14px;
  background: transparent;
  color: var(--dark);
  font-weight: 600;
  padding: 12px 14px;
  text-align: left;
  transition: 0.2s ease;
}

.nav-item:hover,
.nav-item.active {
  background: linear-gradient(135deg, rgba(255, 77, 141, 0.1), rgba(139, 92, 246, 0.12));
  color: #3d2d5e;
}

.mini-profile {
  display: flex;
  align-items: center;
  gap: 12px;
  background: var(--soft-gray);
  border-radius: 18px;
  padding: 12px 10px;
}

.mini-name {
  font-weight: 700;
}

.mini-status {
  color: var(--gray);
  font-size: 0.75rem;
}

.main-panel {
  flex: 1;
  background: rgba(255, 255, 255, 0.56);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 28px;
  padding: 22px;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 18px;
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--gray);
  font-size: 0.68rem;
  margin-bottom: 4px;
}

h1 {
  margin: 0;
  font-size: clamp(1.9rem, 2vw, 2.5rem);
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ghost-button,
.icon-button,
.send-button {
  border: none;
  border-radius: 12px;
  transition: transform 0.2s ease;
}

.ghost-button {
  background: linear-gradient(135deg, rgba(255,77,141,0.12), rgba(139,92,246,0.12));
  color: var(--dark);
  font-weight: 700;
  padding: 10px 16px;
}

.icon-button {
  width: 40px;
  height: 40px;
  background: var(--soft-gray);
  color: var(--dark);
}

.ghost-button:hover,
.icon-button:hover,
.send-button:hover {
  transform: translateY(-1px);
}

.stories {
  display: flex;
  gap: 18px;
  overflow: hidden;
  padding: 8px 4px 18px;
}

.story {
  width: 88px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  color: var(--gray);
  font-size: 0.76rem;
}

.story-ring {
  width: 68px;
  height: 68px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  padding: 3px;
}

.story-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #fff;
  display: grid;
  place-items: center;
  font-weight: 700;
  color: var(--dark);
}

.conversation-panel {
  display: grid;
  grid-template-columns: 320px minmax(420px, 1fr) 280px;
  gap: 18px;
  margin-top: 8px;
}

.list-panel,
.chat-window,
.profile-card,
.highlight-card {
  background: rgba(255, 255, 255, 0.78);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: 24px;
  box-shadow: 0 12px 30px rgba(25, 16, 39, 0.03);
}

.list-panel {
  padding: 12px;
}

.search-box {
  background: var(--soft-gray);
  color: var(--gray);
  padding: 12px 14px;
  border-radius: 12px;
  margin-bottom: 10px;
}

.chat-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 10px;
  border-radius: 16px;
  transition: 0.2s ease;
}

.chat-row.active,
.chat-row:hover {
  background: linear-gradient(135deg, rgba(255, 77, 141, 0.08), rgba(139, 92, 246, 0.08));
}

.avatar {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-weight: 700;
  color: white;
  box-shadow: inset 0 0 0 3px rgba(255,255,255,0.22);
}

.avatar.large {
  width: 62px;
  height: 62px;
}

.chat-body {
  flex: 1;
}

.row-top,
.row-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.row-top {
  margin-bottom: 4px;
}

.row-bottom small {
  color: var(--gray);
  max-width: 200px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.badge {
  min-width: 22px;
  height: 22px;
  border-radius: 999px;
  background: linear-gradient(135deg, #ff4d8d, #8b5cf6);
  color: white;
  display: grid;
  place-items: center;
  font-size: 0.72rem;
  font-weight: 700;
}

.chat-window {
  padding: 18px;
  display: flex;
  flex-direction: column;
  min-height: 650px;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 18px;
  border-bottom: 1px solid rgba(120, 124, 137, 0.08);
}

.header-user {
  display: flex;
  align-items: center;
  gap: 12px;
}

.name {
  font-weight: 700;
}

.status {
  color: var(--gray);
  font-size: 0.72rem;
}

.status.online::before {
  content: '•';
  color: #22c55e;
  margin-right: 5px;
}

.header-actions {
  display: flex;
  gap: 8px;
}

.message-stream {
  display: flex;
  flex-direction: column;
  gap: 14px;
  padding: 20px 0;
  flex: 1;
}

.bubble-wrap {
  display: flex;
}

.bubble-wrap.me {
  justify-content: flex-end;
}

.message-bubble {
  max-width: 72%;
  border-radius: 20px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.message-bubble.other {
  background: var(--soft-gray);
  color: var(--dark);
  border-top-left-radius: 8px;
}

.message-bubble.me {
  background: linear-gradient(135deg, #ff4d8d, #8b5cf6);
  color: white;
  border-top-right-radius: 8px;
}

.message-bubble p {
  margin: 0;
  line-height: 1.5;
}

.message-bubble span {
  font-size: 0.7rem;
  opacity: 0.8;
}

.composer {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--soft-gray);
  border-radius: 18px;
  padding: 10px 12px;
}

.composer input {
  flex: 1;
  border: none;
  background: transparent;
  color: var(--gray);
  padding: 8px 0;
  outline: none;
}

.send-button {
  background: linear-gradient(135deg, #ff4d8d, #8b5cf6);
  color: white;
  font-weight: 700;
  padding: 10px 18px;
}

.profile-panel {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.profile-card,
.highlight-card {
  overflow: hidden;
}

.profile-cover {
  height: 120px;
  background: linear-gradient(135deg, #ffb5d1, #c4b5fd 50%, #93c5fd);
}

.profile-info {
  position: relative;
  margin-top: -28px;
  padding: 0 16px 14px;
  text-align: center;
}

.profile-info .avatar.large {
  margin: 0 auto -10px;
  border: 4px solid white;
}

.profile-info h3 {
  margin: 14px 0 4px;
}

.profile-info p {
  margin: 0;
  color: var(--gray);
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
  padding: 6px 14px 16px;
}

.stats div {
  text-align: center;
  background: var(--soft-gray);
  border-radius: 14px;
  padding: 12px 6px;
}

.stats strong,
.highlight-item strong {
  display: block;
  font-size: 1rem;
}

.stats span,
.highlight-item span {
  color: var(--gray);
  font-size: 0.72rem;
}

.highlight-card {
  padding: 18px 16px;
}

.highlight-card h4 {
  margin: 0 0 12px;
}

.highlight-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.highlight-item {
  display: flex;
  align-items: center;
  gap: 10px;
  background: var(--soft-gray);
  border-radius: 14px;
  padding: 10px 12px;
}

.dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff4d8d, #8b5cf6);
}

.gradient-1 { background: linear-gradient(135deg, #ff7f7f, #ef476f); }
.gradient-2 { background: linear-gradient(135deg, #ff8dbc, #8b5cf6); }
.gradient-3 { background: linear-gradient(135deg, #4ade80, #0ea5e9); }

@media (max-width: 1180px) {
  .conversation-panel {
    grid-template-columns: 1fr;
  }

  .profile-panel {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 860px) {
  .app-shell {
    flex-direction: column;
    margin: 14px;
  }

  .sidebar {
    width: 100%;
  }

  .profile-panel {
    grid-template-columns: 1fr;
  }

  .stories {
    overflow-x: auto;
    padding-bottom: 12px;
  }
}
